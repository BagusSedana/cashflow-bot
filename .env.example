# --- Telegram ---
# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Telegram user id admin (bisa multiple, dipisah koma)
# Cara cari user id kamu: kirim /start ke @userinfobot
ADMIN_IDS=

# Username channel untuk publikasi proof of payment (opsional, tanpa @)
PROOF_CHANNEL_USERNAME=

# --- App ---
# URL database. Default SQLite di file lokal, bisa diganti ke Postgres untuk produksi
# Contoh Postgres: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Branding bot (ditampilkan ke user)
BRAND_NAME=CashFlow ID

# --- Earning rates (dalam rupiah) ---
# Berapa rupiah user dapat per 1 view iklan
EARN_PER_AD=10

# Jeda minimum antar view iklan (detik) untuk anti-spam
AD_COOLDOWN_SECONDS=0

# Bonus referral: persentase earning downline yang masuk ke upline (lifetime)
REFERRAL_PERCENT=5

# Bonus signup untuk referrer saat downline daftar (rupiah)
REFERRAL_SIGNUP_BONUS=500

# --- Withdraw ---
# Minimum withdraw (rupiah)
MIN_WITHDRAW=5000

# Maksimum withdraw per request (rupiah)
MAX_WITHDRAW=500000

# Metode pembayaran yang ditawarkan (dipisah koma): DANA, GoPay, OVO, USDT, BANK
PAYOUT_METHODS=DANA,GoPay,OVO,BANK

# Cooldown antar request withdraw per user (detik). Default 1 jam.
WITHDRAW_COOLDOWN_SECONDS=3600

# --- Daily check-in bonus (rupiah) ---
DAILY_BONUS_MIN=100
DAILY_BONUS_MAX=300

# --- Mini App / Adsgram (v0.2 — real ads) ---
# URL publik Mini App yang serve `webapp/index.html`. Wajib HTTPS untuk Telegram WebApp.
# Kalau kosong, bot pakai mode mock (tombol fallback callback_data="watch_ad").
WEBAPP_URL=

# Host/port aiohttp server lokal yang serve Mini App + API endpoint
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# Adsgram publisher block id (rewarded video). Daftar di https://adsgram.ai
# Kalau kosong, Mini App tetap jalan tapi pakai mock 2-detik delay (TIDAK ADA REVENUE).
ADSGRAM_BLOCK_ID=

# --- Logging ---
LOG_LEVEL=INFO
