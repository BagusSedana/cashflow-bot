{
  "name": "ai-telegram-bot-template",
  "version": "1.0.0",
  "description": "Production-ready AI Telegram Bot Template with ChatGPT, DALL-E Image Generation, Text-to-Speech, Admin Dashboard, and Subscription System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/ --ext .ts",
    "db:migrate": "node dist/database/migrate.js",
    "admin:dev": "cd admin && npx serve -l 3001"
  },
  "keywords": [
    "telegram",
    "bot",
    "ai",
    "chatgpt",
    "openai",
    "dall-e",
    "text-to-speech",
    "template",
    "typescript"
  ],
  "author": "BagusSedana",
  "license": "MIT",
  "dependencies": {
    "grammy": "^1.30.0",
    "openai": "^4.73.0",
    "better-sqlite3": "^11.6.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "winston": "^3.15.0",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
